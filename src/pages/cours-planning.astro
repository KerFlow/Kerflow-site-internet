---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import HelloResaBooking from "../components/HelloResaBooking.astro";
import { courseTypes, peopleForSpace, pricingPlans } from "../data/cmsContent.js";
import { HELLORESA_PLANNING_URL } from "../config/booking.js";

const teachers = peopleForSpace("cours");
---

<BaseLayout
  title="Cours & tarifs - KerFlow - Clamart"
  description="Yoga, Pilates, mobilite, renforcement doux et respiration en petits groupes a Clamart. Planning, tarifs et informations pour reserver un cours KerFlow."
>
  <SiteHeader />
  <main class="cours-page">
    <section class="cours-hero">
      <div class="cours-wrap">
        <div class="cours-hero-grid">
          <div>
            <p class="cours-kicker">KerFlow Studio - cours collectifs</p>
            <h1>
              Petits groupes,<br />
              <em>pratique attentive.</em><br />
              Bouger sans pression.
            </h1>
            <div class="cours-actions">
              <a href="#tarifs" class="btn btn-primary">Tarifs</a>
              <a href="/guides/guide-reservation.pdf" target="_blank" rel="noopener noreferrer" class="btn-line">Guide de réservation</a>
            </div>
          </div>
          <aside class="cours-hero-aside">
            <img class="cours-hero-logo" src="/assets/logos/kerflow-studio-web.png" alt="KerFlow Studio" loading="eager" decoding="async" />
            <p>
              Une diversité de pratique pour que chacun trouve le mouvement qui lui convient. en <em>petits groupes de 8 à 12 élèves</em>,
              tous les jours, dans Le Salon. Progresser, se renforcer, s'alléger.
            </p>
            <div class="cours-tags">
              <span>yoga</span><span>Pilates</span><span>Renforcement doux</span><span>Mobilité</span><span>Respiration</span>
            </div>
          </aside>
        </div>
      </div>
    </section>

    <section class="cours-section">
      <div class="cours-wrap">
        <div class="cours-head">
          <span class="cours-num">01 - Les pratiques</span>
          <h2>À chacun sa façon<br /><em>de bouger</em></h2>
          <p>Cours adaptés, encadrés de près. On commence où l’on est, on avance à son rythme.</p>
        </div>
        <div class="cours-bordered cols-3">
          {courseTypes.map((course) => (
            <button type="button" class="cours-practice-card" data-course-dialog={`course-${course.slug}`}>
              <span>{course.label}</span>
              <h3>{course.title}</h3>
              <p>{course.description}</p>
            </button>
          ))}
          <div class="highlight">
            <span>→</span>
            <h3>Un doute sur le cours ?</h3>
            <p>On vous oriente avant la premiere seance. Ecrivez-nous, on choisit ensemble.</p>
          </div>
        </div>
        {courseTypes.map((course) => (
          <dialog class="course-dialog" id={`course-${course.slug}`} aria-labelledby={`course-${course.slug}-title`}>
            <button type="button" class="course-dialog-close" data-course-dialog-close aria-label="Fermer">×</button>
            <span>{course.label}</span>
            <h3 id={`course-${course.slug}-title`}>{course.title}</h3>
            <p>{course.longDescription}</p>
          </dialog>
        ))}
      </div>
    </section>

    <section id="tarifs" class="cours-section paper">
      <div class="cours-wrap">
        <div class="cours-head">
          <span class="cours-num">02 - Tarifs</span>
          <h2>À chacun<br /><em>sa formule.</em></h2>
          <p>Certains poussent la porte pour essayer, d'autres viennent chaque semaine, d'autres choisissent de s'engager dans un cycle.</p>
        </div>
        <div class="cours-pricing">
          {pricingPlans.map((plan) => (
            <div class={`cours-pricing-card${plan.featured ? " feature" : ""}`}>
              <span>{plan.name}</span>
              {plan.intro && <p>{plan.intro}</p>}
              <ul>
                {plan.features.map((feature) => <li>{feature}</li>)}
              </ul>
              <a href={HELLORESA_PLANNING_URL} target="_blank" rel="noopener noreferrer" class="btn btn-primary">{plan.ctaLabel} ↗</a>
            </div>
          ))}
        </div>
        <p class="cours-note">Si vous avez besoin d'assistance pour réserver, on peut vous aider. <a href="/contact/">Contactez-nous</a> !</p>
      </div>
    </section>

    <HelloResaBooking sectionNumber="03" />

    <section id="equipe" class="cours-section paper">
      <div class="cours-wrap">
        <div class="cours-head">
          <span class="cours-num">04 - Les intervenantes</span>
          <h2>Une équipe<br /><em>attentive.</em></h2>
          <p>Des parcours et des approches différentes, réunis par une même attention à chacune et chacun.</p>
        </div>
        <div class="cours-team">
          {teachers.map((person, index) => {
            const instagram = person.secondaryLinkUrl && person.secondaryLinkUrl !== "#" && person.secondaryLinkUrl.includes("instagram.com");
            return (
              <a class={`cours-team-card cours-team-card-${index + 1}`} href={`/intervenantes/${person.slug}/`} aria-label={`Découvrir ${person.name.trim()}, ${person.specialty}`}>
                <div class="cours-team-image">
                  {person.visualMode === "image" && person.image ? <img src={person.image} alt={person.imageLabel || person.name} loading="lazy" decoding="async" style={`object-position: ${person.imagePositionX ?? 50}% ${person.imagePositionY ?? 50}%`} /> : <div class={`cours-team-placeholder ${person.imageClass}`}><span>{person.imageLabel || person.name}</span></div>}
                  <span class="cours-team-index">{String(index + 1).padStart(2, "0")}</span>
                  <span class="cours-team-view">Découvrir <b aria-hidden="true">↗</b></span>
                </div>
                <div class="cours-team-meta">
                  <div><h3>{person.name.trim()}</h3><p>{person.specialty}</p></div>
                  {instagram && <span class="cours-team-instagram" aria-label="Instagram"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r=".8" fill="currentColor" stroke="none"/></svg></span>}
                </div>
              </a>
            );
          })}
        </div>
      </div>
    </section>

    <style>
      .cours-team { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:24px; align-items:start; margin-top:clamp(32px,4vw,52px); }
      .cours-team-card { min-width:0; color:inherit; text-decoration:none; }
      .cours-team-image { position:relative; overflow:hidden; aspect-ratio:.79; background:var(--stone); }
      .cours-team-image::after { content:""; position:absolute; inset:45% 0 0; background:linear-gradient(transparent,rgba(14,38,38,.35)); opacity:.55; transition:opacity .3s ease; }
      .cours-team-image img,.cours-team-placeholder { display:block; width:100%; height:100%; object-fit:cover; transition:transform .7s cubic-bezier(.2,.65,.25,1); }
      .cours-team-placeholder { display:grid; place-items:center; background:radial-gradient(ellipse at 35% 25%,#a9b9a5,#536f66 70%); color:#f6f3ec; font:italic 24px 'Fraunces',serif; }
      .cours-team-placeholder.storm { background:radial-gradient(ellipse at 35% 25%,#92afad,#315957 70%); }
      .cours-team-placeholder.clay { background:radial-gradient(ellipse at 35% 25%,#d8a58a,#865742 70%); }
      .cours-team-placeholder.foam { background:radial-gradient(ellipse at 35% 25%,#c4d2c7,#67817b 70%); }
      .cours-team-card:hover img,.cours-team-card:focus-visible img,.cours-team-card:hover .cours-team-placeholder,.cours-team-card:focus-visible .cours-team-placeholder { transform:scale(1.045); }
      .cours-team-card:hover .cours-team-image::after,.cours-team-card:focus-visible .cours-team-image::after { opacity:.9; }
      .cours-team-index { position:absolute; z-index:1; top:14px; left:15px; color:white; font:10px 'DM Mono',monospace; letter-spacing:.08em; }
      .cours-team-view { position:absolute; z-index:1; right:14px; bottom:14px; display:flex; align-items:center; gap:10px; color:white; font:11px 'DM Mono',monospace; letter-spacing:.1em; text-transform:uppercase; opacity:0; transform:translateY(5px); transition:opacity .25s ease,transform .25s ease; }
      .cours-team-view b { display:grid; place-items:center; width:30px; height:30px; border:1px solid rgba(255,255,255,.75); border-radius:50%; font-size:16px; font-weight:400; }
      .cours-team-card:hover .cours-team-view,.cours-team-card:focus-visible .cours-team-view { opacity:1; transform:translateY(0); }
      .cours-team-meta { display:flex; justify-content:space-between; align-items:flex-start; gap:8px; padding:17px 1px 0; }
      .cours-team-meta h3 { margin:0 0 5px; font:400 clamp(21px,2vw,27px)/1.1 'Fraunces',Georgia,serif; }
      .cours-team-meta p { margin:0; color:#637472; font:10px/1.6 'DM Mono',monospace; letter-spacing:.04em; text-transform:uppercase; }
      .cours-team-instagram { flex:0 0 20px; width:20px; height:20px; margin-top:3px; color:var(--clay); }
      .cours-team-instagram svg { width:100%; height:100%; fill:none; stroke:currentColor; stroke-width:1.6; }
      @media(max-width:1180px) { .cours-team { grid-template-columns:repeat(3,minmax(0,1fr)); } }
      @media(max-width:850px) { .cours-team { grid-template-columns:repeat(2,minmax(0,1fr)); gap:26px 18px; } }
      @media(max-width:480px) { .cours-team { gap:24px 12px; } .cours-team-meta { padding-top:12px; } .cours-team-meta h3 { font-size:21px; } .cours-team-meta p { font-size:8px; } }
      @media(prefers-reduced-motion:reduce) { .cours-team-image img,.cours-team-placeholder,.cours-team-view,.cours-team-image::after { transition:none; } }
    </style>

    <section id="public" class="cours-section">
      <div class="cours-wrap">
        <div class="cours-head">
          <span class="cours-num">05 - Pour qui ?</span>
          <h2>Chacun vient pour<br /><em>une raison différente.</em></h2>
        </div>
        <ul class="cours-check-list">
          <li><p><strong>Une reprise en douceur</strong> après une pause, une grossesse, un arrêt.</p></li>
          <li><p><strong>Sportifs & actifs</strong> - gagner en mobilité, récupérer, compléter sa pratique et prévenir les blessures.</p></li>
          <li><p><strong>Seniors actifs</strong> - des cours adaptés, attentifs, sans esprit de compétition.</p></li>
          <li><p><strong>Stress & fatigue</strong> - déposer la charge mentale, retrouver du souffle.</p></li>
          <li><p><strong>À chaque saison de la vie</strong> - grossesse, post-partum, préménopause ou ménopause : des pratiques adaptées aux évolutions du corps.</p></li>
          <li><p><strong>Douleurs & mobilité</strong> - dénouer, assouplir, soulager sans forcer.</p></li>
        </ul>
      </div>
    </section>

    <section id="petits-groupes" class="cours-section paper">
      <div class="cours-wrap">
        <div class="cours-split-head">
          <div class="cours-head">
            <span class="cours-num">06 - Pourquoi en petit groupe ?</span>
            <h2>Ici,<br /><em>chacun compte.</em></h2>
          </div>
          <p>
            Des cours à taille humaine, où l'on profite à la fois de l'énergie du groupe
            et de l'attention portée à chacun. Plus de confort, plus de lien et un accompagnement plus personnalisé.
          </p>
        </div>
        <div class="cours-steps">
          <div><h3>Encadrement attentif</h3><p>Le professeur vous voit, vous accompagne et vous propose des ajustements adaptés à votre pratique.</p></div>
          <div><h3>Cadre chaleureux</h3><p>Moins de monde, plus de confort. Chacun trouve sa place et pratique dans une ambiance sereine.</p></div>
          <div><h3>Dynamique de groupe</h3><p>On retrouve les mêmes visages semaine après semaine, dans une atmosphère conviviale et sans anonymat.</p></div>
        </div>
      </div>
    </section>

    <section class="cours-section">
      <div class="cours-wrap">
        <div class="cours-head">
          <span class="cours-num">07 - Avant de venir</span>
          <h2>Quelques questions<br /><em>que l'on nous pose.</em></h2>
        </div>
        <div class="cours-faq">
          <details><summary>Faut-il être souple ou sportive ?<span></span></summary><p>Non, pas forcément. On vient pour gagner en souplesse et en aisance. Les cours s'adaptent à chaque corps - on commence où l'on en est.</p></details>
          <details><summary>Quel matériel apporter ?<span></span></summary><p>Une tenue confortable, éventuellement votre serviette pour les pratiques au sol et votre gourde. Tapis et matériel sont fournis sur place. Des casiers sont à votre disposition dans les vestiaires.</p></details>
          <details><summary>C'est adapté si je reprends après une longue pause ?<span></span></summary><p>Tout à fait. La plupart de nos cours sont pensés pour les reprises. Dites-le nous, on vous oriente vers le bon créneau.</p></details>
          <details><summary>Et si j'ai des douleurs ?<span></span></summary><p>Signalez-les à l'arrivée : le professeur adapte les postures. Nos cours de Sport Santé sont particulièrement indiqués pour travailler en douceur autour d'une douleur.</p></details>
          <details><summary>Comment réserver et annuler ?<span></span></summary><p>Les réservations se font en ligne via HelloResa. L'annulation est possible jusqu'à 24 heures avant le début du cours, sans frais.</p></details>
        </div>
        <a href="/faq/" class="btn-line">Toutes les questions →</a>
      </div>
    </section>

    <section class="cours-cta">
      <div class="cours-wrap">
        <h2>Votre premier cours<br />est <em>à 10 euros.</em></h2>
        <div>
          <p>Venez avec votre tenue de pratique, pas besoin d'apporter vos chaussures de sport, les tapis et le matériel sont fournis sur place.</p>
          <div class="cours-actions">
            <a href={HELLORESA_PLANNING_URL} target="_blank" rel="noopener noreferrer" class="btn btn-light">Réserver mon premier cours ↗</a>
            <a href="#tarifs" class="btn-line on-dark">Voir les tarifs →</a>
          </div>
        </div>
      </div>
    </section>
  </main>
  <script>
    document.querySelectorAll("[data-course-dialog]").forEach((trigger) => {
      trigger.addEventListener("click", () => {
        const dialog = document.getElementById(trigger.dataset.courseDialog);
        if (dialog instanceof HTMLDialogElement) {
          dialog.showModal();
        }
      });
    });

    document.querySelectorAll("[data-course-dialog-close]").forEach((trigger) => {
      trigger.addEventListener("click", () => {
        const dialog = trigger.closest("dialog");
        if (dialog instanceof HTMLDialogElement) {
          dialog.close();
        }
      });
    });

    document.querySelectorAll(".course-dialog").forEach((dialog) => {
      dialog.addEventListener("click", (event) => {
        if (event.target === dialog && dialog instanceof HTMLDialogElement) {
          dialog.close();
        }
      });
    });
  </script>
  <SiteFooter />
</BaseLayout>
