---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import { workshops } from "../../data/cmsContent.js";

export function getStaticPaths() {
  return workshops.map((workshop) => ({
    params: { slug: workshop.slug },
    props: { workshop },
  }));
}

const { workshop } = Astro.props;
const paragraphs = workshop.description
  .split(/\n\s*\n/)
  .map((paragraph) => paragraph.trim())
  .filter(Boolean);
---

<BaseLayout title={`${workshop.title} - Ateliers KerFlow`} description={workshop.summary}>
  <SiteHeader />
  <main class="workshop-page wrapped-sections">
    <header class="workshop-hero">
      <div class="workshop-wrap">
        <a href="/#ateliers" class="workshop-back"><span aria-hidden="true">←</span> Retour aux ateliers</a>
        <div class="workshop-hero-grid">
          <div class="workshop-title-block">
            <p class="workshop-kicker">Atelier · {workshop.date} · {workshop.time}</p>
            <h1>{workshop.title}</h1>
            <p class="workshop-lede">{workshop.summary}</p>
            <div class="workshop-facts">
              <span>{workshop.duration}</span>
              <span>{workshop.price}</span>
            </div>
            {workshop.bookingRequired !== false && (
              <a class="workshop-booking" href={workshop.ctaUrl}>{workshop.ctaLabel} <span aria-hidden="true">→</span></a>
            )}
            {workshop.bookingRequired === false && <span class="workshop-no-booking">Sans réservation</span>}
          </div>
          <div class={`workshop-hero-photo ${workshop.imageClass} ${workshop.image ? "has-upload" : ""}`}>
            {workshop.image ? (
              <img src={workshop.image} alt={workshop.imageLabel || workshop.title} loading="eager" decoding="async" />
            ) : (
              <span>{workshop.imageLabel || workshop.title}</span>
            )}
          </div>
        </div>
      </div>
    </header>

    <section class="workshop-content">
      <div class="workshop-content-inner">
        <p class="workshop-content-kicker">À propos de l'atelier</p>
        <div class="workshop-body">
          {paragraphs.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>

<style>
  .workshop-page { background: var(--paper); color: var(--granite); }
  .workshop-wrap { width: min(1180px, calc(100% - 48px)); margin-inline: auto; }
  .workshop-hero { padding: clamp(38px, 6vw, 80px) 0 clamp(60px, 8vw, 112px); background: var(--paper); }
  .workshop-back { display: inline-flex; gap: 10px; margin-bottom: 42px; color: var(--petrol); font-size: 13px; text-decoration: none; }
  .workshop-hero-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(300px, .86fr); gap: clamp(36px, 7vw, 96px); align-items: center; }
  .workshop-kicker, .workshop-content-kicker { margin: 0 0 18px; color: var(--clay); font-family: var(--mono); font-size: 11px; letter-spacing: .16em; text-transform: uppercase; }
  .workshop-title-block h1 { max-width: 720px; margin: 0 0 24px; color: var(--petrol-deep); font-family: var(--serif-display); font-size: clamp(42px, 6.2vw, 82px); font-weight: 400; letter-spacing: -.035em; line-height: .98; }
  .workshop-lede { max-width: 620px; margin: 0; color: var(--granite-500); font-size: clamp(17px, 1.7vw, 21px); line-height: 1.6; }
  .workshop-facts { display: flex; flex-wrap: wrap; gap: 12px; margin: 30px 0; }
  .workshop-facts span { padding: 9px 13px; border: 1px solid var(--rule); border-radius: 999px; color: var(--granite-500); font-size: 13px; }
  .workshop-booking { display: inline-flex; align-items: center; gap: 12px; padding: 14px 20px; border-radius: 3px; background: var(--petrol); color: white; font-size: 14px; text-decoration: none; }
  .workshop-no-booking { display: inline-flex; align-items: center; min-height: 46px; padding: 0 16px; border: 1px solid var(--rule); border-radius: 3px; background: var(--bone); color: var(--granite-500); font-size: 13px; }
  .workshop-hero-photo { position: relative; overflow: hidden; min-height: 420px; aspect-ratio: 4 / 5; border-radius: 6px; background: linear-gradient(145deg, var(--photo-a, #9bbab8), var(--photo-b, #3f6e6f)); }
  .workshop-hero-photo.has-upload { background: #e4e0d8; }
  .workshop-hero-photo img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .workshop-hero-photo > span { position: absolute; inset: auto 20px 18px; color: white; font-family: var(--mono); font-size: 11px; letter-spacing: .1em; }
  .workshop-content { padding: clamp(60px, 8vw, 112px) 24px; border-top: 1px solid var(--rule); background: var(--paper-soft, #f4f1eb); }
  .workshop-content-inner { display: grid; grid-template-columns: minmax(170px, .55fr) minmax(0, 1.4fr); column-gap: clamp(30px, 7vw, 100px); row-gap: 28px; max-width: 960px; margin: 0 auto; }
  .workshop-content-kicker { margin-top: 8px; }
  .workshop-body { color: var(--granite-500); font-size: 17px; line-height: 1.8; }
  .workshop-body p { margin: 0 0 1.35em; white-space: pre-line; }
  .workshop-content-inner > .workshop-booking { grid-column: 2; justify-self: start; }
  @media (max-width: 760px) {
    .workshop-wrap { width: min(100% - 36px, 560px); }
    .workshop-hero-grid { grid-template-columns: 1fr; }
    .workshop-hero-photo { min-height: 280px; aspect-ratio: 4 / 3; }
    .workshop-content-inner { grid-template-columns: 1fr; gap: 12px; }
    .workshop-content-inner > .workshop-booking { grid-column: 1; margin-top: 14px; }
  }
</style>
