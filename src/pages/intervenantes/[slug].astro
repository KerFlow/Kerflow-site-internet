---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import { visiblePeople } from "../../data/cmsContent.js";

export function getStaticPaths() {
  return visiblePeople.map((person) => ({ params: { slug: person.slug }, props: { person } }));
}

const { person } = Astro.props;
const name = person.name.trim();
const backHref = person.spaces.includes("le-cocon") || person.spaces.includes("la-bulle")
  ? "/accompagnements-sante-soins/"
  : "/equipe-demo/";
const backLabel = backHref.startsWith("/accompagnements") ? "Accompagnement et soins" : "Toute l’équipe";
const approachSections = person.approachSections ?? [];
const relatedPeople = visiblePeople.filter((item) => item.slug !== person.slug).slice(0, 3);
const primaryHref = person.primaryLinkUrl?.includes("@") ? `mailto:${person.primaryLinkUrl.trim()}` : person.primaryLinkUrl;
const hasInstagram = person.secondaryLinkUrl && person.secondaryLinkUrl !== "#" && person.secondaryLinkUrl.includes("instagram.com");
const instagramName = hasInstagram ? person.secondaryLinkUrl.split("instagram.com/")[1]?.split(/[/?#]/)[0] : "";
---

<BaseLayout title={`${name} — ${person.specialty} | KerFlow`} description={`${name}, ${person.specialty}. Découvrez son parcours et son approche chez KerFlow.`}>
  <SiteHeader />
  <main class="instructor-page">
    <header class="instructor-hero">
      <div class="instructor-wrap">
        <a href={backHref} class="instructor-back"><span aria-hidden="true">←</span> {backLabel}</a>
        <div class="instructor-hero-grid">
          <div class="instructor-intro">
            <p class="instructor-kicker">KerFlow Studio <span>·</span> Intervenante</p>
            <h1>{name}<span class="instructor-period">.</span></h1>
            <p class="instructor-specialty">{person.specialty}</p>
            <p class="instructor-lede">{person.summary ?? "Une pratique attentive, adaptée à votre rythme et à votre histoire."}</p>
            <div class="instructor-actions">
              {primaryHref && <a class="instructor-cta" href={primaryHref}>{person.primaryLinkLabel || "Prendre rendez-vous"}<span aria-hidden="true">↗</span></a>}
              {hasInstagram && <a class="instructor-social" href={person.secondaryLinkUrl} target="_blank" rel="noopener noreferrer"><span class="instructor-instagram-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r=".8" fill="currentColor" stroke="none"/></svg></span>{instagramName}</a>}
            </div>
          </div>
          <figure class={`instructor-photo ${person.imageClass} ${person.visualMode === "image" && person.image ? "has-upload" : ""}`}>
            {person.visualMode === "image" && person.image ? <img src={person.image} alt={`Portrait de ${name}`} loading="eager" decoding="async" style={`object-position: ${person.imageCrops?.profile?.x ?? person.imagePositionX ?? 50}% ${person.imageCrops?.profile?.y ?? person.imagePositionY ?? 50}%`} /> : <span>{person.imageLabel || name}</span>}
            <figcaption><span>01</span><span>Rencontre avec {name}</span></figcaption>
          </figure>
        </div>
        <div class="instructor-bottomline"><span>Le mouvement, à votre manière</span><span>Clamart · KerFlow</span></div>
      </div>
    </header>

    <section class="instructor-story">
      <div class="instructor-story-inner">
        <div class="instructor-story-label"><span>Son approche</span><span class="instructor-flower" aria-hidden="true">✳</span></div>
        <div class="instructor-bio">
          <h2>{person.approachTitle}<br /><em>{person.approachAccent}</em></h2>
          <div class="instructor-copy">
            {approachSections.map((section) => (
              <section class={`instructor-copy-section heading-${section.headingStyle}`}>
                {section.heading && <h3>{section.heading}</h3>}
                {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
              </section>
            ))}
          </div>
        </div>
      </div>
    </section>

    {relatedPeople.length > 0 && (
      <section class="instructor-related related-section rule-top band-paper" data-screen-label="Les autres intervenantes">
        <div class="instructor-wrap">
          <div class="related-head">
            <span class="sec-num">À découvrir aussi</span>
            <h2 class="serif">Les autres<br /><i>intervenant·es KerFlow.</i></h2>
          </div>
          <div class="related-grid">
            {relatedPeople.map((relatedPerson) => (
              <a href={`/intervenantes/${relatedPerson.slug}/`} class="art">
                <div class={`ph instructor-card-photo t-${relatedPerson.imageClass} ${relatedPerson.visualMode === "image" && relatedPerson.image ? "has-upload" : ""}`}>
                  {relatedPerson.visualMode === "image" && relatedPerson.image ? (
                    <img src={relatedPerson.image} alt={`Portrait de ${relatedPerson.name.trim()}`} loading="lazy" decoding="async" style={`object-position: ${relatedPerson.imageCrops?.horizontalCard?.x ?? relatedPerson.imagePositionX ?? 50}% ${relatedPerson.imageCrops?.horizontalCard?.y ?? relatedPerson.imagePositionY ?? 50}%`} />
                  ) : (
                    <span class="cap">{relatedPerson.imageLabel || relatedPerson.name.trim()}</span>
                  )}
                </div>
                <div class="a-body">
                  <span class="a-tag">{relatedPerson.specialty}</span>
                  <h3 class="serif">{relatedPerson.name.trim()}</h3>
                  <p>{relatedPerson.summary ?? ""}</p>
                  <span class="a-foot">Découvrir son approche →</span>
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}
  </main>
  <SiteFooter />
</BaseLayout>

<style>
  .instructor-page { --ip-ink:var(--petrol); --ip-paper:var(--paper); --ip-clay:var(--clay); background:var(--ip-paper); color:var(--ip-ink); }
  .instructor-wrap { width:min(1180px,calc(100% - 48px)); margin:auto; }
  .instructor-hero { padding:clamp(34px,5vw,68px) 0 clamp(46px,7vw,92px); }
  .instructor-back { display:inline-flex; align-items:center; gap:10px; margin-bottom:clamp(30px,5vw,64px); color:#60716f; text-decoration:none; font-size:13px; }
  .instructor-back:hover { color:var(--ip-clay); }
  .instructor-hero-grid { display:grid; grid-template-columns:minmax(0,1fr) minmax(320px,.82fr); align-items:center; gap:clamp(40px,8vw,110px); }
  .instructor-kicker { margin:0 0 22px; color:var(--ip-clay); font:10px 'DM Mono',monospace; letter-spacing:.16em; text-transform:uppercase; }
  .instructor-kicker span { padding:0 6px; color:#82908a; }
  .instructor-intro h1 { margin:0; font:400 clamp(64px,10vw,126px)/.92 'Fraunces',Georgia,serif; letter-spacing:-.055em; }
  .instructor-period { color:var(--ip-clay); }
  .instructor-specialty { max-width:520px; margin:22px 0 0; color:var(--ip-clay); font:11px/1.7 'DM Mono',monospace; letter-spacing:.08em; text-transform:uppercase; }
  .instructor-lede { max-width:430px; margin:26px 0 0; color:#5d706d; font:clamp(17px,1.7vw,21px)/1.65 'Manrope',sans-serif; }
  .instructor-actions { display:flex; align-items:center; flex-wrap:wrap; gap:22px; margin-top:34px; }
  .instructor-cta { display:inline-flex; align-items:center; gap:26px; padding:15px 19px; background:var(--ip-ink); color:#fff; text-decoration:none; font-size:13px; transition:background .2s ease; }
  .instructor-cta:hover { background:var(--ip-clay); }
  .instructor-cta span { font-size:17px; }
  .instructor-social { display:inline-flex; align-items:center; gap:9px; color:#637572; text-decoration:none; font:10px 'DM Mono',monospace; letter-spacing:.08em; }
  .instructor-social:hover { color:var(--ip-clay); }
  .instructor-instagram-icon { width:18px; height:18px; color:var(--ip-clay); }
  .instructor-instagram-icon svg { width:100%; height:100%; fill:none; stroke:currentColor; stroke-width:1.6; }
  .instructor-photo { position:relative; overflow:hidden; aspect-ratio:4/5; margin:0; background:linear-gradient(145deg,#a7b8aa,#57706a); }
  .instructor-photo.has-upload { background:#e3dfd7; }
  .instructor-photo img { display:block; width:100%; height:100%; object-fit:cover; }
  .instructor-photo > span { display:grid; width:100%; height:100%; place-items:center; color:white; font:italic 30px 'Fraunces',serif; }
  .instructor-photo figcaption { position:absolute; right:0; bottom:0; left:0; display:flex; justify-content:space-between; padding:15px 18px; color:white; background:linear-gradient(transparent,rgba(15,42,42,.56)); font:9px 'DM Mono',monospace; letter-spacing:.12em; text-transform:uppercase; }
  .instructor-bottomline { display:flex; justify-content:space-between; gap:20px; margin-top:clamp(34px,5vw,62px); padding-top:15px; border-top:1px solid rgba(23,62,64,.24); color:#71807c; font:9px 'DM Mono',monospace; letter-spacing:.13em; text-transform:uppercase; }
  .instructor-story { padding-block:var(--site-section-y); background:var(--bone); }
  .instructor-story-inner { display:grid; grid-template-columns:minmax(150px,.45fr) minmax(0,1.55fr); gap:clamp(30px,7vw,100px); width:min(1180px,calc(100% - 48px)); margin:auto; }
  .instructor-story-label { display:flex; justify-content:space-between; align-items:flex-start; color:var(--ip-clay); font:10px 'DM Mono',monospace; letter-spacing:.14em; text-transform:uppercase; }
  .instructor-flower { font-size:24px; line-height:1; }
  .instructor-bio h2 { margin:0 0 34px; font:400 clamp(39px,6vw,68px)/1.02 'Fraunces',Georgia,serif; letter-spacing:-.035em; }
  .instructor-bio h2 em { color:var(--ip-clay); font-weight:300; }
  .instructor-copy { max-width:690px; color:#566a67; font:16px/1.85 'Manrope',sans-serif; }
  .instructor-copy p { margin:0 0 1.2em; white-space:pre-line; }
  .instructor-copy-section + .instructor-copy-section { margin-top:30px; }
  .instructor-copy-section h3 { margin:0 0 12px; color:var(--ip-ink); font:600 17px/1.35 var(--sans); }
  .instructor-copy-section.heading-large h3 { margin-bottom:14px; color:var(--ip-clay); font:400 clamp(21px,2vw,25px)/1.16 var(--serif); }
  .instructor-related { padding-block:var(--site-section-y); border-top:1px solid var(--rule); background:var(--paper); }
  .instructor-related .related-head { display:flex; flex-direction:column; gap:16px; margin-bottom:clamp(28px,3vw,40px); }
  .instructor-related .related-head h2 { margin:0; color:var(--petrol-deep); font-family:var(--serif); font-size:clamp(34px,5vw,64px); font-weight:400; font-variation-settings:"opsz" 144; letter-spacing:-.02em; line-height:1.03; }
  .instructor-related .related-head i { color:var(--ip-clay); font-weight:300; }
  .instructor-related .related-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:clamp(16px,2.2vw,24px); }
  .instructor-related .art { display:flex; overflow:hidden; flex-direction:column; border:1px solid var(--rule); background:var(--paper); color:inherit; text-decoration:none; transition:transform .25s ease,box-shadow .25s ease; }
  .instructor-related .art:hover,.instructor-related .art:focus-visible { transform:translateY(-4px); box-shadow:0 18px 40px -28px rgba(14,42,44,.5); }
  .instructor-related .art .ph { width:100%; aspect-ratio:3/2; }
  .instructor-related .art .ph.has-upload::before,.instructor-related .art .ph.has-upload::after { display:none; }
  .instructor-related .art .ph img { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; }
  .instructor-related .a-body { display:flex; flex:1; flex-direction:column; gap:13px; padding:clamp(24px,2.4vw,32px); }
  .instructor-related .a-tag { color:var(--ip-clay); font-family:var(--mono); font-size:10px; letter-spacing:.18em; text-transform:uppercase; }
  .instructor-related .art h3 { margin:0; color:var(--petrol-deep); font-size:clamp(20px,1.8vw,24px); font-weight:400; line-height:1.12; }
  .instructor-related .art p { display:-webkit-box; overflow:hidden; margin:0; color:var(--granite-500); font-size:14px; line-height:1.62; -webkit-box-orient:vertical; -webkit-line-clamp:3; }
  .instructor-related .a-foot { margin-top:auto; padding-top:18px; border-top:1px solid var(--rule-soft); color:var(--granite-500); font-family:var(--mono); font-size:10px; letter-spacing:.18em; text-transform:uppercase; }
  @media(max-width:900px) { .instructor-related .related-grid { grid-template-columns:1fr; } }
  @media(max-width:760px) { .instructor-wrap { width:min(100% - 36px,560px); } .instructor-hero-grid { grid-template-columns:1fr; gap:36px; } .instructor-photo { width:min(100%,460px); justify-self:center; aspect-ratio:4/4.5; } .instructor-story-inner { width:min(100% - 36px,560px); grid-template-columns:1fr; gap:30px; } .instructor-story-label { max-width:460px; } }
  @media(prefers-reduced-motion:reduce) { .instructor-cta { transition:none; } }
</style>
