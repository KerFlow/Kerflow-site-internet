---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import { visiblePeople } from "../../data/cmsContent.js";

export function getStaticPaths() {
  return visiblePeople.map((person) => ({ params: { slug: person.slug }, props: { person } }));
}

const { person } = Astro.props;
const name = person.name.trim();
const paragraphs = person.bio.split(/\n\s*\n|\n/).map((paragraph) => paragraph.trim()).filter(Boolean);
const primaryHref = person.primaryLinkUrl?.includes("@") ? `mailto:${person.primaryLinkUrl.trim()}` : person.primaryLinkUrl;
const hasInstagram = person.secondaryLinkUrl && person.secondaryLinkUrl !== "#" && person.secondaryLinkUrl.includes("instagram.com");
const instagramName = hasInstagram ? person.secondaryLinkUrl.split("instagram.com/")[1]?.split(/[/?#]/)[0] : "";
---

<BaseLayout title={`${name} — ${person.specialty} | KerFlow`} description={`${name}, ${person.specialty}. Découvrez son parcours et son approche chez KerFlow.`}>
  <SiteHeader />
  <main class="instructor-page">
    <header class="instructor-hero">
      <div class="instructor-wrap">
        <a href="/equipe-demo/" class="instructor-back"><span aria-hidden="true">←</span> Toute l’équipe</a>
        <div class="instructor-hero-grid">
          <div class="instructor-intro">
            <p class="instructor-kicker">KerFlow Studio <span>·</span> Intervenante</p>
            <h1>{name}<span class="instructor-period">.</span></h1>
            <p class="instructor-specialty">{person.specialty}</p>
            <p class="instructor-lede">Une pratique attentive, adaptée à votre rythme et à votre histoire.</p>
            <div class="instructor-actions">
              {primaryHref && <a class="instructor-cta" href={primaryHref}>{person.primaryLinkLabel || "Prendre rendez-vous"}<span aria-hidden="true">↗</span></a>}
              {hasInstagram && <a class="instructor-social" href={person.secondaryLinkUrl} target="_blank" rel="noopener noreferrer"><span class="instructor-instagram-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r=".8" fill="currentColor" stroke="none"/></svg></span>{instagramName}</a>}
            </div>
          </div>
          <figure class={`instructor-photo ${person.imageClass} ${person.visualMode === "image" && person.image ? "has-upload" : ""}`}>
            {person.visualMode === "image" && person.image ? <img src={person.image} alt={`Portrait de ${name}`} loading="eager" decoding="async" style={`object-position: ${person.imagePositionX ?? 50}% ${person.imagePositionY ?? 50}%`} /> : <span>{person.imageLabel || name}</span>}
            <figcaption><span>01</span><span>Rencontre avec {name}</span></figcaption>
          </figure>
        </div>
        <div class="instructor-bottomline"><span>Le mouvement, à votre manière</span><span>Clamart · KerFlow</span></div>
      </div>
    </header>

    <section class="instructor-story">
      <div class="instructor-story-inner">
        <div class="instructor-story-label"><span>Son approche</span><span class="instructor-flower" aria-hidden="true">✳</span></div>
        <div class="instructor-bio">
          <h2>Prendre le temps<br /><em>de sentir.</em></h2>
          <div class="instructor-copy">{paragraphs.map((paragraph) => <p>{paragraph}</p>)}</div>
        </div>
      </div>
    </section>

    <section class="instructor-end">
      <p>La porte est ouverte.</p>
      <div><a href="/cours-planning/">Découvrir les cours <span aria-hidden="true">↗</span></a><a href="/equipe-demo/">Rencontrer l’équipe <span aria-hidden="true">↗</span></a></div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>

<style>
  .instructor-page { --ip-ink:var(--petrol); --ip-paper:var(--paper); --ip-clay:var(--clay); background:var(--ip-paper); color:var(--ip-ink); }
  .instructor-wrap { width:min(1180px,calc(100% - 48px)); margin:auto; }
  .instructor-hero { padding:clamp(34px,5vw,68px) 0 clamp(46px,7vw,92px); }
  .instructor-back { display:inline-flex; align-items:center; gap:10px; margin-bottom:clamp(30px,5vw,64px); color:#60716f; text-decoration:none; font-size:13px; }
  .instructor-back:hover { color:var(--ip-clay); }
  .instructor-hero-grid { display:grid; grid-template-columns:minmax(0,1fr) minmax(320px,.82fr); align-items:center; gap:clamp(40px,8vw,110px); }
  .instructor-kicker { margin:0 0 22px; color:var(--ip-clay); font:10px 'DM Mono',monospace; letter-spacing:.16em; text-transform:uppercase; }
  .instructor-kicker span { padding:0 6px; color:#82908a; }
  .instructor-intro h1 { margin:0; font:400 clamp(64px,10vw,126px)/.92 'Fraunces',Georgia,serif; letter-spacing:-.055em; }
  .instructor-period { color:var(--ip-clay); }
  .instructor-specialty { max-width:520px; margin:22px 0 0; color:var(--ip-clay); font:11px/1.7 'DM Mono',monospace; letter-spacing:.08em; text-transform:uppercase; }
  .instructor-lede { max-width:430px; margin:26px 0 0; color:#5d706d; font:clamp(17px,1.7vw,21px)/1.65 'Manrope',sans-serif; }
  .instructor-actions { display:flex; align-items:center; flex-wrap:wrap; gap:22px; margin-top:34px; }
  .instructor-cta { display:inline-flex; align-items:center; gap:26px; padding:15px 19px; background:var(--ip-ink); color:#fff; text-decoration:none; font-size:13px; transition:background .2s ease; }
  .instructor-cta:hover { background:var(--ip-clay); }
  .instructor-cta span { font-size:17px; }
  .instructor-social { display:inline-flex; align-items:center; gap:9px; color:#637572; text-decoration:none; font:10px 'DM Mono',monospace; letter-spacing:.08em; }
  .instructor-social:hover { color:var(--ip-clay); }
  .instructor-instagram-icon { width:18px; height:18px; color:var(--ip-clay); }
  .instructor-instagram-icon svg { width:100%; height:100%; fill:none; stroke:currentColor; stroke-width:1.6; }
  .instructor-photo { position:relative; overflow:hidden; aspect-ratio:4/5; margin:0; background:linear-gradient(145deg,#a7b8aa,#57706a); }
  .instructor-photo.has-upload { background:#e3dfd7; }
  .instructor-photo img { display:block; width:100%; height:100%; object-fit:cover; }
  .instructor-photo > span { display:grid; width:100%; height:100%; place-items:center; color:white; font:italic 30px 'Fraunces',serif; }
  .instructor-photo figcaption { position:absolute; right:0; bottom:0; left:0; display:flex; justify-content:space-between; padding:15px 18px; color:white; background:linear-gradient(transparent,rgba(15,42,42,.56)); font:9px 'DM Mono',monospace; letter-spacing:.12em; text-transform:uppercase; }
  .instructor-bottomline { display:flex; justify-content:space-between; gap:20px; margin-top:clamp(34px,5vw,62px); padding-top:15px; border-top:1px solid rgba(23,62,64,.24); color:#71807c; font:9px 'DM Mono',monospace; letter-spacing:.13em; text-transform:uppercase; }
  .instructor-story { padding:clamp(62px,9vw,120px) 24px; background:var(--bone); }
  .instructor-story-inner { display:grid; grid-template-columns:minmax(150px,.45fr) minmax(0,1.55fr); gap:clamp(30px,7vw,100px); max-width:960px; margin:auto; }
  .instructor-story-label { display:flex; justify-content:space-between; align-items:flex-start; color:var(--ip-clay); font:10px 'DM Mono',monospace; letter-spacing:.14em; text-transform:uppercase; }
  .instructor-flower { font-size:24px; line-height:1; }
  .instructor-bio h2 { margin:0 0 34px; font:400 clamp(39px,6vw,68px)/1.02 'Fraunces',Georgia,serif; letter-spacing:-.035em; }
  .instructor-bio h2 em { color:var(--ip-clay); font-weight:300; }
  .instructor-copy { max-width:690px; color:#566a67; font:16px/1.85 'Manrope',sans-serif; }
  .instructor-copy p { margin:0 0 1.2em; white-space:pre-line; }
  .instructor-end { display:flex; justify-content:space-between; align-items:center; gap:28px; max-width:1180px; margin:auto; padding:40px 24px 54px; }
  .instructor-end > p { margin:0; color:var(--ip-clay); font:italic clamp(24px,3vw,36px) 'Fraunces',serif; }
  .instructor-end > div { display:flex; gap:26px; flex-wrap:wrap; }
  .instructor-end a { display:flex; gap:12px; color:var(--ip-ink); text-decoration:none; font:10px 'DM Mono',monospace; letter-spacing:.1em; text-transform:uppercase; }
  .instructor-end a:hover { color:var(--ip-clay); }
  @media(max-width:760px) { .instructor-wrap { width:min(100% - 36px,560px); } .instructor-hero-grid { grid-template-columns:1fr; gap:36px; } .instructor-photo { width:min(100%,460px); justify-self:center; aspect-ratio:4/4.5; } .instructor-story-inner { grid-template-columns:1fr; gap:30px; } .instructor-story-label { max-width:460px; } .instructor-end { align-items:flex-start; flex-direction:column; } }
  @media(prefers-reduced-motion:reduce) { .instructor-cta { transition:none; } }
</style>
