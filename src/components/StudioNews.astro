---
import { siteSettings } from "../data/cmsContent.js";

const studioNews = siteSettings.openingLabel?.trim();
---

{studioNews && (
  <aside class="studio-news mono" aria-label="Actualité du studio">
    <span class="studio-news-label"><span class="studio-news-mark" aria-hidden="true"></span> Info studio</span>
    <p>{studioNews}</p>
  </aside>
)}

<style>
  .studio-news {
    display: grid;
    grid-template-columns: minmax(120px, 1fr) minmax(0, 2fr) minmax(120px, 1fr);
    align-items: center;
    gap: clamp(14px, 2vw, 28px);
    min-height: 48px;
    padding: 10px var(--site-pad-x, clamp(20px, 6vw, 88px));
    color: var(--paper, #faf6ee);
    background: var(--clay, #a05a3a);
    animation: studio-news-in 620ms cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .studio-news-label {
    display: inline-flex;
    align-items: center;
    justify-self: start;
    gap: 8px;
    font-family: var(--sans, Manrope, sans-serif);
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .studio-news-mark {
    width: 6px;
    height: 6px;
    border: 1px solid currentColor;
    border-radius: 50%;
    background: currentColor;
    box-shadow: 0 0 0 2px rgba(255, 255, 255, 0.16);
  }

  .studio-news p {
    grid-column: 2;
    margin: 0;
    text-align: center;
    font-family: var(--sans, Manrope, sans-serif);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.015em;
    line-height: 1.4;
  }

  @keyframes studio-news-in {
    from { opacity: 0; transform: translateY(-8px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @media (max-width: 760px) {
    .studio-news {
      grid-template-columns: 1fr;
      gap: 4px;
      min-height: 0;
      padding-block: 9px;
    }

    .studio-news-label { font-size: 9px; }
    .studio-news p { grid-column: 1; text-align: left; }
  }

  @media (prefers-reduced-motion: reduce) {
    .studio-news { animation: none; }
  }
</style>
